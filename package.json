{
  "name": "@strutvane/logs",
  "version": "0.1.0-next.0",
  "description": "Zero-config logging for TypeScript apps: structured non-blocking logs, rotation and retention, secret redaction, request logging, and a built-in, locked-down log viewer.",
  "keywords": [
    "strutvane",
    "logging",
    "logger",
    "log-viewer",
    "redaction",
    "request-logging",
    "typescript",
    "nodejs"
  ],
  "homepage": "https://github.com/vishwajit-vm/strutvane-logs#readme",
  "bugs": {
    "url": "https://github.com/vishwajit-vm/strutvane-logs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishwajit-vm/strutvane-logs.git"
  },
  "license": "MIT",
  "author": "The Strutvane Authors",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./http": {
      "types": "./dist/http.d.mts",
      "default": "./dist/http.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./hono": {
      "types": "./dist/hono.d.mts",
      "default": "./dist/hono.mjs"
    },
    "./express": {
      "types": "./dist/express.d.mts",
      "default": "./dist/express.mjs"
    },
    "./viewer": {
      "types": "./dist/viewer.d.mts",
      "default": "./dist/viewer.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown",
    "ci": "biome check . && tsc --noEmit && vitest run --coverage && tsdown",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@strutvane/contracts": "0.1.0-next.0"
  },
  "peerDependencies": {
    "express": "^5.0.0",
    "hono": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@changesets/cli": "3.0.3",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "express": "5.3.0",
    "fast-check": "4.10.2",
    "hono": "4.13.18",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
